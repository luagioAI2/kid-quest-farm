# 依赖
node_modules/
# 中断的安装留下的半成品目录（117MB，2026-10-14 在 farm-2d worktree 里发现）
node_modules.partial/

# 构建产物
dist/
dist-ssr/
*.local

# 游戏包产物（`npm run build:games` → games-src/ 的独立构建）。
# ⚠️ **刻意不入库、也不进 App 的 dist** —— 它们是要**下发**的东西，
# 不该被打进 APK（那正是「独立下载」要解决的问题，见 spec §12）。
games-dist/

# ★ catalog 的**签名私钥**（`scripts/sign-catalog.mjs keygen` 产出）。
# 私钥 = 「我是这个 App 的作者」这个身份；它进了仓库，任何拿到仓库的人
# 都能签一个「官方」包，而客户端只认签名。公钥是另一回事 ——
# 公钥**必须**入库（烧在 src/games/catalogKey.ts 里）。
catalog-keys/

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Android 构建产物与本地配置
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
android/app/release/
android/app/debug/
*.keystore
*.jks
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# 端到端截图
screenshots/

# e2e 跑起来时 Chrome 的 profile 目录（IndexedDB 就住在这里面）。
# 特意放在项目同盘、而不是系统临时目录 —— 系统盘满会让 Chrome 抛
# FILE_ERROR_NO_SPACE，症状是 e2e 随机挂在任意一条用例上。
# 见 scripts/lib/profile.mjs。
.e2e-scratch/

# 打包出来的 APK 副本（供直接分发，体积大不入库）
dist-apk/

# 官网里的两块**产物**（site/ 其余部分都入库）：
#   site/app/       App 的 Web 构建产物（「在线体验」按钮指向它）
#   site/download/  安装包副本
# 两者都能用 `npm run site`（scripts/build-site.mjs）从 src/ 和 dist-apk/ 重新生成。
# ⚠️ 但 site/img/ 是**入库**的：那些界面图要从「跑起来的 App」截出来
#    （capture.mjs + make-site-assets.py），链条比 build 长得多，
#    而且页面 HTML 直接引它们，不入库的话克隆下来就是一片破图。
site/app/
site/download/

# 测试
coverage/

# 图标处理链路（assets/icon/）：
# 只把**源图**入库。下面这些都是 make_transparent.py / generate_icons.py
# 能重新跑出来的中间产物和预览图，加起来 4MB 多，没必要进版本库。
# 重新生成：见 README「应用图标」。
assets/icon/icon-transparent.png
assets/icon/icon-square.png
assets/icon/edge-zoom.png
assets/icon/icon-preview.png
assets/icon/icon-set-preview.png
assets/icon/favicon-sizes.png
assets/icon/favicon-zoom.png
assets/icon/splash-mark-unused.webp
assets/icon/launcher-composite.png
assets/icon/window-margin.png

# 助手在本地记的工作笔记（memory/）：
# 里面全是本机路径、临时探针、试错过程，属于「这个工作目录的草稿」，
# 不是 App 的源码或文档。仓库是公开的，别把它推上去。
.workbuddy-ai/

# 一次性探针（scripts/__*.mjs）：
# 「跑一遍验证某个推断、用完即删」的临时脚本。**结论**该沉淀进 docs/，
# 或者升级成正式的 e2e 守卫（scripts/e2e-*.mjs）；脚本本身不入库。
# 例：scripts/__verify-reset.mjs（验证「清空全部数据」真的清干净）。
scripts/__*.mjs
